{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://onebot-cxx.github.io/obcx/schemas/actor-package.schema.json",
  "title": "OBCX actor.toml",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "actor",
    "artifact",
    "dependencies",
    "compatibility",
    "publication"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "version", "abi"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)(?:-[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?(?:\\+[0-9A-Za-z-]+(?:\\.[0-9A-Za-z-]+)*)?$"
        },
        "abi": { "const": 2 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "target", "kind", "entrypoint", "platforms"],
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_-]*$"
        },
        "target": { "type": "string", "minLength": 1 },
        "kind": { "const": "shared-library" },
        "entrypoint": { "const": "obcx_create_actor_v2" },
        "platforms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "linux-x86_64",
              "linux-arm64"
            ]
          }
        }
      }
    },
    "dependencies": {
      "type": "object",
      "additionalProperties": false,
      "required": ["packages", "actors"],
      "properties": {
        "packages": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9._+-]*$"
          }
        },
        "actors": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "version"],
            "properties": {
              "id": {
                "type": "string",
                "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)*$"
              },
              "version": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "obcx",
        "actor_abi_min",
        "actor_abi_max",
        "cpp_standard",
        "compiler",
        "reflection_macro",
        "input_contract_schema"
      ],
      "properties": {
        "obcx": { "type": "string", "minLength": 1 },
        "actor_abi_min": { "const": 2 },
        "actor_abi_max": { "const": 2 },
        "cpp_standard": { "const": 26 },
        "compiler": { "const": "gcc>=16.1" },
        "reflection_macro": { "const": 202506 },
        "input_contract_schema": { "const": 1 }
      }
    },
    "publication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "license", "description"],
      "properties": {
        "repository": { "type": "string", "format": "uri" },
        "homepage": { "type": "string", "format": "uri" },
        "license": { "type": "string", "minLength": 1 },
        "description": { "type": "string", "minLength": 1 }
      }
    }
  }
}
