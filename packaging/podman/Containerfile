# Build an amd64 OBCX runtime image using the Nix flake dev shell.
#
# Build:
#   podman build --platform linux/amd64 --security-opt seccomp=unconfined -f packaging/podman/Containerfile -t obcx:nix-amd64 .
#
# Run with host tests mounted:
#   podman run --rm -v "$PWD/tests:/workspace/tests:ro" obcx:nix-amd64

FROM --platform=linux/amd64 docker.io/nixos/nix:latest AS builder

WORKDIR /workspace
ARG CMAKE_BUILD_TYPE=Release
ARG CMAKE_BUILD_PARALLEL_LEVEL=

RUN mkdir -p /etc/nix \
  && printf 'experimental-features = nix-command flakes\nfilter-syscalls = false\n' >> /etc/nix/nix.conf

COPY flake.nix flake.lock ./
RUN nix develop .#default --command true

COPY . .
RUN rm -rf build \
  && nix develop .#default --command cmake -B build -GNinja -DCMAKE_BUILD_TYPE="${CMAKE_BUILD_TYPE}" \
  && if [ -n "${CMAKE_BUILD_PARALLEL_LEVEL:-}" ]; then \
       nix develop .#default --command cmake --build build --parallel "${CMAKE_BUILD_PARALLEL_LEVEL}"; \
     else \
       nix develop .#default --command cmake --build build; \
     fi

RUN mkdir -p /runtime-root/workspace/tests /runtime-root/workspace/logs \
  && FFMPEG_BIN="$(nix develop .#default --command sh -c 'command -v ffmpeg')" \
  && AWK_BIN="$(nix develop .#default --command sh -c 'command -v awk')" \
  && test -x "${FFMPEG_BIN}" \
  && test -x "${AWK_BIN}" \
  && cd /workspace \
  && find build -type f \( -perm -111 -o -name '*.so' -o -name '*.so.*' \) -print0 \
    | xargs -0 -r cp -a --parents -t /runtime-root/workspace \
  && { \
       printf '%s\n' "${FFMPEG_BIN}"; \
       find /runtime-root/workspace/build -type f -print0 \
         | xargs -0 -r ldd 2>/dev/null \
         | "${AWK_BIN}" '/=> \/nix\/store\// { print $3 } /^[[:space:]]*\/nix\/store\// { print $1 }'; \
       find /runtime-root/workspace/build -type f -exec grep -aoh '/nix/store/[[:alnum:]]\{32\}-[^/:[:space:]]*' {} + 2>/dev/null; \
     } | sort -u \
    | while read -r store_path; do \
        [ -e "${store_path}" ] && printf '%s\n' "${store_path}"; \
      done \
    | xargs -r nix-store -qR \
    | sort -u \
    | xargs -I{} cp -a --parents {} /runtime-root \
  && mkdir -p /runtime-root/usr/local/bin \
  && ln -s "${FFMPEG_BIN}" /runtime-root/usr/local/bin/ffmpeg \
  && test -x /runtime-root/workspace/build/src/plugin/obcx \
  && test -x /runtime-root/usr/local/bin/ffmpeg \
  && test -d /runtime-root/nix/store

FROM scratch AS runtime

COPY --from=builder /runtime-root /

ENV PATH="/usr/local/bin"

WORKDIR /workspace
CMD ["/workspace/build/src/plugin/obcx", "tests/config.toml", "--no-tui"]
